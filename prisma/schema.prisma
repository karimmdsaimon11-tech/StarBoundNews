datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          String      @default("REPORTER") // SUPER_ADMIN, EDITOR, REPORTER, AUTHOR, AD_MANAGER
  avatar        String?
  bio           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  author        Author?
  auditLogs     AuditLog[]
}

model Author {
  id            String      @id @default(cuid())
  name          String
  nameBn        String?
  slug          String      @unique
  email         String?
  designation   String      @default("Staff Reporter")
  designationBn String?     @default("স্টাফ রিপোর্টার")
  avatar        String?
  bio           String?
  bioBn         String?
  facebook      String?
  twitter       String?
  linkedin      String?
  userId        String?     @unique
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  articles      Article[]
  opinions      Article[]   @relation("AuthorOpinions")
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  nameBn        String
  slug          String        @unique
  description   String?
  order         Int           @default(0)
  icon          String?
  isNav         Boolean       @default(true)
  color         String?       @default("#1E3E62")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subcategories Subcategory[]
  articles      Article[]
  videos        VideoStory[]
}

model Subcategory {
  id          String      @id @default(cuid())
  name        String
  nameBn      String
  slug        String      @unique
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  articles    Article[]
}

model District {
  id          String      @id @default(cuid())
  name        String      @unique
  nameBn      String
  slug        String      @unique
  division    String
  divisionBn  String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())

  articles    Article[]
}

model Article {
  id                  String          @id @default(cuid())
  title               String
  titleBn             String?
  slug                String          @unique
  subtitle            String?
  excerpt             String
  content             String
  featuredImage       String
  imageCaption        String?
  photographerCredit  String?
  
  categoryId          String
  category            Category        @relation(fields: [categoryId], references: [id])
  subcategoryId       String?
  subcategory         Subcategory?    @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  
  authorId            String
  author              Author          @relation(fields: [authorId], references: [id])
  
  districtId          String?
  district            District?       @relation(fields: [districtId], references: [id], onDelete: SetNull)

  opinionAuthorId     String?
  opinionAuthor       Author?         @relation("AuthorOpinions", fields: [opinionAuthorId], references: [id], onDelete: SetNull)

  tags                String?         // comma separated or JSON string
  status              String          @default("DRAFT") // DRAFT, PENDING_REVIEW, SCHEDULED, PUBLISHED, ARCHIVED
  
  isBreaking          Boolean         @default(false)
  isHero              Boolean         @default(false)
  isFeatured          Boolean         @default(false)
  isTrending          Boolean         @default(false)
  isOpinion           Boolean         @default(false)
  isEditorial         Boolean         @default(false)
  
  viewsCount          Int             @default(0)
  readTimeMinutes     Int             @default(3)

  seoTitle            String?
  seoDescription      String?
  focusKeyword        String?
  canonicalUrl        String?

  scheduledAt         DateTime?
  publishedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  versions            ArticleVersion[]
  views               ArticleView[]
  comments            Comment[]
  breakingNewsItems   BreakingNews[]
}

model ArticleVersion {
  id          String      @id @default(cuid())
  articleId   String
  article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int         @default(1)
  title       String
  content     String
  editorName  String
  createdAt   DateTime    @default(now())
}

model ArticleView {
  id          String      @id @default(cuid())
  articleId   String
  article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ipHash      String?
  userAgent   String?
  referrer    String?
  createdAt   DateTime    @default(now())
}

model Comment {
  id          String        @id @default(cuid())
  articleId   String
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name        String
  email       String
  content     String
  status      String        @default("PENDING") // PENDING, APPROVED, REJECTED, FLAGGED
  createdAt   DateTime      @default(now())
}

model Media {
  id                  String      @id @default(cuid())
  url                 String
  filename            String
  mimeType            String
  sizeBytes           Int         @default(0)
  width               Int?
  height              Int?
  altText             String?
  caption             String?
  photographerCredit  String?
  createdAt           DateTime    @default(now())
}

model PhotoGallery {
  id                  String              @id @default(cuid())
  title               String
  titleBn             String?
  slug                String              @unique
  description         String?
  coverImage          String
  photographerCredit  String?
  publishedAt         DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  images              PhotoGalleryImage[]
}

model PhotoGalleryImage {
  id                  String        @id @default(cuid())
  galleryId           String
  gallery             PhotoGallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl            String
  caption             String?
  photographerCredit  String?
  order               Int           @default(0)
  createdAt           DateTime      @default(now())
}

model VideoStory {
  id            String      @id @default(cuid())
  title         String
  titleBn       String?
  slug          String      @unique
  description   String?
  videoUrl      String
  thumbnailUrl  String
  duration      String      @default("03:45")
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isFeatured    Boolean     @default(false)
  viewsCount    Int         @default(0)
  publishedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BreakingNews {
  id          String      @id @default(cuid())
  headline    String
  headlineBn  String?
  url         String?
  articleId   String?
  article     Article?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  isActive    Boolean     @default(true)
  priority    Int         @default(1)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Advertisement {
  id                String        @id @default(cuid())
  name              String
  advertiser        String
  imageUrl          String
  targetUrl         String
  placement         String        // TOP_BANNER, HEADER, HOMEPAGE_HERO, IN_FEED, ARTICLE_TOP, ARTICLE_MIDDLE, ARTICLE_BOTTOM, SIDEBAR, MOBILE_STICKY, FOOTER
  deviceTargeting   String        @default("ALL") // ALL, DESKTOP, MOBILE
  impressionsCount  Int           @default(0)
  clicksCount       Int           @default(0)
  isActive          Boolean       @default(true)
  priority          Int           @default(1)
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model HomepageSection {
  id            String      @id @default(cuid())
  title         String
  titleBn       String
  slug          String      @unique
  type          String      @default("CATEGORY") // HERO, CATEGORY, OPINION, VIDEO, GALLERY
  categoryId    String?
  articleLimit  Int         @default(5)
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SiteSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  group       String      @default("GENERAL") // GENERAL, BRANDING, SOCIAL, CONTACT, ADVERTISING, ANALYTICS
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model NewsletterSubscriber {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  status        String      @default("ACTIVE")
  subscribedAt  DateTime    @default(now())
}

model ContactInquiry {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model AdInquiry {
  id            String      @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String?
  budget        String?
  placement     String?
  message       String
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  action      String
  details     String?
  ipAddress   String?
  createdAt   DateTime    @default(now())
}
